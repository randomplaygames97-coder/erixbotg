# Configurazione Bot Telegram IPTV
# Copia questo file in .env e modificalo con i tuoi valori

# Token del bot Telegram (richiesto)
# Per ottenere il token, scrivi a @BotFather su Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Percorso del database SQLite
DATABASE_PATH=./data/iptv_bot.db

# ID degli admin (separati da virgola)
# Per trovare il tuo ID Telegram, scrivi a @userinfobot
ADMIN_IDS=123456789

# ID del super admin (opzionale, sovrascrive ADMIN_IDS per funzionalità extra)
SUPER_ADMIN_ID=123456789

# Nome del bot (visualizzato nei messaggi)
BOT_NAME=IPTV Manager Bot

# Versione del bot
BOT_VERSION=1.0.0

# Modalità debug (true/false)
DEBUG_MODE=false
